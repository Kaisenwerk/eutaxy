#!/usr/bin/env node
// Checks a commit message, or a pull request title, against the commit rules:
// a Conventional Commit header with no trailing period, at most 72
// characters, where GitHub cuts a commit title short. A pull request title is
// held to 64, leaving room for the " (#<number>)" its squash commit adds.
//   git hook:  git config core.hooksPath .githooks
//   by hand:   .githooks/commit-msg --title "<pull request title>"
import { readFileSync } from "node:fs";

const TYPES = ["feat", "fix", "perf", "refactor", "test", "docs", "build", "ci", "chore", "style", "revert"];
const HEADER = new RegExp(`^(${TYPES.join("|")})(\\([a-z0-9][a-z0-9./-]*\\))?!?: \\S`);
// Messages git writes itself: merges, autosquash, and git revert.
const GENERATED = /^(Merge |(fixup|squash|amend)! |Revert ")/;

const [mode, value = ""] = process.argv.slice(2);
const title = mode === "--title";
const lines = title
  ? [value]
  : readFileSync(mode, "utf8")
      .split(/^# -+ >8 -+$/m)[0]
      .split("\n")
      .filter((line) => !line.startsWith("#"))
      .join("\n")
      .trim()
      .split("\n");
const [header = "", second] = lines;
const limit = title ? 64 : 72;
const what = title ? "Title" : "Header";

const errors = GENERATED.test(header)
  ? []
  : [
      ...(HEADER.test(header) ? [] : [`${what} must be "<type>(<scope>): <description>", type one of ${TYPES.join(", ")}.`]),
      ...(header.length > limit ? [`${what} is ${header.length} characters; at most ${limit}.`] : []),
      ...(header.endsWith(".") ? [`${what} must not end with a period.`] : []),
      ...(second !== undefined && second !== "" ? ["Leave a blank line after the header."] : []),
    ];
if (errors.length > 0) {
  console.error(`${title ? "Pull request title" : "Commit message"} refused:\n${errors.map((e) => `  - ${e}`).join("\n")}`);
  process.exit(1);
}
