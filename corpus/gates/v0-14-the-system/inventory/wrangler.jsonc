{
  "name": "inventory",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [{ "binding": "DB", "database_name": "inventory", "database_id": "inventory" }],
  "durable_objects": { "bindings": [{ "name": "STOCK", "class_name": "Stock" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Stock"] }],
  "workflows": [{ "name": "fulfilment", "binding": "FULFILMENT", "class_name": "Fulfilment" }]
}
