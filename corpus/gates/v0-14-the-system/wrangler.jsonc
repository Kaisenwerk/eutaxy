{
  "name": "storefront",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [{ "binding": "DB", "database_name": "storefront", "database_id": "storefront" }],
  "queues": {
    "consumers": [{ "queue": "orders", "max_batch_size": 1, "max_retries": 3 }]
  },
  // The inventory Worker, by its real name: eutaxy check runs its code inside this scenario.
  "services": [{ "binding": "INVENTORY", "service": "inventory" }],
  // The inventory Worker's stock objects, read here directly: one namespace shared by both Workers.
  "durable_objects": {
    "bindings": [{ "name": "STOCK", "class_name": "Stock", "script_name": "inventory" }]
  }
}
