{
  "name": "gate-v0-17-object-stores",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": { "bindings": [{ "name": "LIBRARY", "class_name": "Library" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Library"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catalogue",
      "database_id": "00000000-0000-0000-0000-000000000017"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "library" }]
}
