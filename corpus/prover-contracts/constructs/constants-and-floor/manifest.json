{
  "description": "Module-level constants, the module's own and one built on an imported one, are read as their values; Math.floor and / are read as JavaScript computes them on doubles, checked on test262's edge values. The Lean engine takes Math.floor(x / c) for a positive integer constant c and refuses other division; a claim true over the integers and false for 0.5 is proved by the Lean engine and refuted by the SMT engine. Z3 gives up on the window claims, which need Math.floor over a division of doubles across a range; the Lean engine proves them over the integers.",
  "covers": [
    "module-constant",
    "floor-division",
    "division",
    "math-floor",
    "number-is-integer",
    "precondition",
    "const-arrow"
  ],
  "expect": {
    "tested": {
      "windowOf": {
        "windowStartsBefore": "TESTED",
        "nextWindow": "TESTED"
      },
      "locked": {
        "lockedFromFive": "TESTED"
      },
      "floorOf": {
        "floorKeepsIntegers": "TESTED",
        "floorNeverLower": "REFUTED",
        "halfIsInteger": "REFUTED"
      },
      "ratio": {
        "halves": "TESTED"
      }
    },
    "lean": {
      "windowOf": {
        "windowStartsBefore": "PROVEN",
        "nextWindow": "PROVEN"
      },
      "locked": {
        "lockedFromFive": "PROVEN"
      },
      "floorOf": {
        "floorKeepsIntegers": "PROVEN",
        "floorNeverLower": "PROVEN",
        "halfIsInteger": "unsupported"
      },
      "ratio": {
        "halves": "unsupported"
      }
    },
    "smt": {
