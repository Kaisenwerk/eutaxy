{
  "name": "eutaxy-workspace",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rm -rf packages/*/dist packages/*/.tsc corpus/*/dist tests/dist packages/*/*.tsbuildinfo corpus/*/*.tsbuildinfo tests/*.tsbuildinfo",
    "build": "tsdown"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@cloudflare/vitest-plugin": "1.4.6",
    "@cloudflare/workers-types": "5.20261022.1",
    "@types/node": "24.19.2",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
