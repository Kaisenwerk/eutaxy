{
  "name": "eutaxy",
  "version": "0.6.0",
  "description": "Deterministic simulation and formal proof for TypeScript on Cloudflare Workers",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kaisenwerk/eutaxy.git",
    "directory": "packages/eutaxy"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "deterministic-simulation",
    "simulation-testing",
    "fault-injection",
    "model-checking",
    "formal-verification",
    "invariants",
    "cloudflare",
    "cloudflare-workers",
    "durable-objects",
    "workerd",
    "vitest",
    "aws-lambda",
    "testing"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./cloudflare": "./src/cloudflare.ts",
    "./aws": "./src/aws.ts",
    "./spec": "./src/spec.ts"
  },
  "bin": {
    "eutaxy": "./bin/eutaxy.mjs"
  },
  "types": "./src/index.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm -w run build",
    "prepack": "pnpm -w run build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "./cloudflare": {
        "types": "./dist/cloudflare.d.mts",
        "default": "./dist/cloudflare.mjs"
      },
      "./aws": {
        "types": "./dist/aws.d.mts",
        "default": "./dist/aws.mjs"
      },
      "./spec": {
        "types": "./dist/spec.d.mts",
        "default": "./dist/spec.mjs"
      }
    },
    "bin": {
      "eutaxy": "./dist/bin.mjs"
    },
    "types": "./dist/index.d.mts"
  },
  "peerDependencies": {
    "@cloudflare/vitest-plugin": ">=1.4.0",
    "@cloudflare/workers-types": ">=4.0.0",
    "vitest": ">=4.1.0",
    "@aws-sdk/client-dynamodb": ">=3.0.0",
    "@aws-sdk/util-dynamodb": ">=3.0.0",
    "@smithy/smithy-client": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@cloudflare/workers-types": {
      "optional": true
    },
    "@aws-sdk/client-dynamodb": {
      "optional": true
    },
    "@aws-sdk/util-dynamodb": {
      "optional": true
    },
    "@smithy/smithy-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eutaxy/aws": "workspace:*",
    "@eutaxy/cli": "workspace:*",
    "@eutaxy/cloudflare": "workspace:*",
    "@eutaxy/core": "workspace:*",
    "@eutaxy/engine": "workspace:*",
    "@eutaxy/prover": "workspace:*",
    "@eutaxy/prover-lean": "workspace:*",
    "@eutaxy/prover-lemmascript": "workspace:*",
    "@eutaxy/prover-smt": "workspace:*",
    "@eutaxy/prover-thales": "workspace:*",
    "@eutaxy/report": "workspace:*",
    "@eutaxy/spec": "workspace:*",
    "@types/node": "24.19.2"
  }
}
