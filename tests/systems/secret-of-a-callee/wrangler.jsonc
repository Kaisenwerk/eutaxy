{
  "name": "front",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // The config's own value; the scenario's envVar("REGION") replaces it for the check.
  "vars": { "REGION": "from-the-config" },
  // The notes Worker, by its real name: eutaxy check runs its code inside this scenario.
  "services": [{ "binding": "NOTES", "service": "notes" }]
}
